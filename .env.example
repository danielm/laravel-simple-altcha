# Laravel ALTCHA: copy these into your application's .env
# (this is a package, so the file is documentation; it is not loaded automatically)

# REQUIRED. Signs challenges so clients can't forge them.
# Use a different value per project/environment.
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ALTCHA_HMAC_SECRET=

# Optional. Key derivation algorithm: pbkdf2 | argon2id | scrypt
# argon2id needs ext-sodium, scrypt needs ext-scrypt.
# Your widget build must support the algorithm you choose.
ALTCHA_ALGORITHM=pbkdf2

# Optional. Work factor. Meaning depends on the algorithm
# (pbkdf2: iterations, e.g. 10000; argon2id: time cost, e.g. 2-3).
# Higher = harder for bots, but slower for real users' devices.
ALTCHA_COST=10000

# Optional. Seconds before an issued challenge expires.
ALTCHA_EXPIRES_IN=120

# Optional. Cache store used for replay protection (a solved payload works once).
# Leave empty to use your default cache store. In production use redis,
# memcached or database (the "file" driver is not atomic).
ALTCHA_CACHE_STORE=

# Optional. Enables the library's fast verification path. Only applies to
# challenges created with a counter, which this package doesn't do by default.
ALTCHA_HMAC_KEY_SECRET=

# Testing only. A payload equal to this value passes verification, but only
# when APP_ENV=testing. Put it in .env.testing, never in production.
# ALTCHA_TESTING_BYPASS=let-me-in
